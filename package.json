{
  "name": "shelf",
  "version": "0.1.0",
  "description": "A database client with an interface worth looking at",
  "author": {
    "name": "LBYPatrick",
    "email": "lbypatrick@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "electron-rebuild --only better-sqlite3",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs",
    "package:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac",
    "package:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win",
    "package:linux": "pnpm build && electron-builder --config electron-builder.config.cjs --linux",
    "shots": "playwright test --config playwright.shots.config.ts",
    "test:drivers": "vitest run --config vitest.drivers.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1109.0",
    "@aws-sdk/credential-providers": "^3.1109.0",
    "@aws-sdk/lib-dynamodb": "^3.1109.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@redis/client": "^6.2.1",
    "better-sqlite3": "^13.0.3",
    "cassandra-driver": "^4.9.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "i18next-vue": "^5.4.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "pg-cursor": "^2.15.4",
    "portfinder": "^1.0.38",
    "ssh-config": "^5.0.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "axe-core": "^4.13.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "daisyui": "^5.7.16",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.14.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.8.2",
    "sql-query-identifier": "^3.2.0",
    "tabulator-tables": "^6.5.2",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "@duckdb/node-bindings-darwin-arm64": "1.5.5-r.4",
    "@duckdb/node-bindings-darwin-x64": "1.5.5-r.4",
    "@duckdb/node-bindings-linux-arm64": "1.5.5-r.4",
    "@duckdb/node-bindings-linux-x64": "1.5.5-r.4",
    "@duckdb/node-bindings-win32-arm64": "1.5.5-r.4",
    "@duckdb/node-bindings-win32-x64": "1.5.5-r.4"
  }
}
